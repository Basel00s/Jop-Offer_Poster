# Copy this file to .env and fill in your own values
#
# MONGO_URI — use localhost when running directly on the host (npm run dev),
#             use "mongo" (the Docker service name) when running via docker compose.
# Uncomment the one you need:
MONGO_URI=mongodb://localhost:27017/job-poster
# MONGO_URI=mongodb://mongo:27017/job-poster

PORT=3000
SESSION_SECRET=your-secret-key-here-make-it-long-and-random

# The owner account is created by running: node scripts/seed-owner.js
# Do NOT set a password in this file — auth uses the User collection.

# SMTP config for email notifications on new candidate submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
